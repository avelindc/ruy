{
  "name": "breakout-music-api",
  "version": "1.0.0",
  "description": "Breakout Music API - Cloudflare Workers Backend",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.toml --env development",
    "deploy": "wrangler deploy --config ./wrangler.toml --env=\"\"",
    "migrate": "node ./scripts/migrate.mjs",
    "provision:admin": "node ./scripts/provision-admin.mjs",
    "build": "tsc",
    "test:auth": "npm run build && node --import ./tests/register-extension-loader.mjs --test tests/auth.test.mjs",
    "test:all": "npm run build && node --import ./tests/register-extension-loader.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261015.1",
    "pg": "^8.23.1",
    "typescript": "^5.6.3",
    "wrangler": "4.123.0"
  }
}
